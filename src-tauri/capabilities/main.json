{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the main viewer window may use dialogs and receive backend events.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-open-path",
    "allow-navigate",
    "allow-current-snapshot",
    "allow-read-render"
  ]
}
