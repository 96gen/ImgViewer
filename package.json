{
  "name": "imgviewer",
  "private": true,
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/96gen/ImgViewer.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:security": "vitest run tests/securityContract.spec.ts tests/snapshotProtocol.spec.ts",
    "audit:production": "pnpm audit --prod --audit-level high",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
